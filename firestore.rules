rules_version = '2';

// DRIPPR seller panel - Firestore security rules.
//
// This file mirrors the rules deployed on the project so the repo is the
// source of truth. Scope: these govern the BROWSER only. Every function in
// api/ uses the Firebase Admin SDK, which bypasses rules entirely, so the
// panel's privileged work (approvals, Shopify sync, order transitions, admin
// reads) is gated by the ADMIN_UIDS allowlist instead.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() {
      return request.auth != null;
    }

    // Admin if /admins/{uid}.enabled == true
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // Per-document owner check.
    //
    // This is also the correct form for `list`: rules are evaluated against
    // every document a query would return, so a query that is not already
    // filtered to the caller simply fails. An earlier version used a
    // `request.query.where(...)` helper, but `request.query` only exposes
    // limit / offset / orderBy - there is no `where` - so that call raised an
    // error and silently denied sellers access to their own support tickets.
    function isOwnerByMerchantId() {
      return signedIn() && resource.data.merchantId == request.auth.uid;
    }

    function sellerUpdateDoesNotTouchAdminSupportFields() {
      let disallowed = ['adminReply','adminUid','assigneeUid','internalNotes','resolvedAt','status'];
      return request.resource.data.diff(resource.data).changedKeys().hasAny(disallowed) == false;
    }

    function sellerUpdateDoesNotTouchAdminProfileFields() {
      let disallowed = ['enabled','role','isAdmin','createdAt'];
      return request.resource.data.diff(resource.data).changedKeys().hasAny(disallowed) == false;
    }

    /* ---------- admins ---------- */
    match /admins/{uid} {
      allow get:  if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if false; // server only
    }

    /* ---------- merchants (seller profiles) ---------- */
    match /merchants/{uid} {
      allow get:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        (request.auth.uid == uid && sellerUpdateDoesNotTouchAdminProfileFields()) || isAdmin()
      );
      allow delete: if false;
    }

    /* ---------- merchantProducts (Shopify mirror) ---------- */
    match /merchantProducts/{docId} {
      allow get:  if signedIn() && (isOwnerByMerchantId() || isAdmin());
      allow list: if signedIn() && (isAdmin() || isOwnerByMerchantId());
      allow create, update, delete: if false; // server only
    }

    /* ---------- orders (per-merchant order mirror) ---------- */
    match /orders/{orderId} {
      allow get:  if signedIn() && (isOwnerByMerchantId() || isAdmin());
      allow list: if signedIn() && (isAdmin() || isOwnerByMerchantId());
      // Written by the Shopify webhooks and the order workflow endpoints.
      allow create, update, delete: if false;
    }

    /* ---------- merchantStats (dashboard counters) ---------- */
    match /merchantStats/{uid} {
      allow get:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    /* ---------- payouts ---------- */
    match /payouts/{payoutId} {
      allow get:  if signedIn() && (isOwnerByMerchantId() || isAdmin());
      allow list: if signedIn() && (isAdmin() || isOwnerByMerchantId());
      allow create, update, delete: if false;
    }

    /* ---------- supportRequests ---------- */
    match /supportRequests/{ticketId} {
      allow get:  if signedIn() && (isOwnerByMerchantId() || isAdmin());
      allow list: if signedIn() && (isAdmin() || isOwnerByMerchantId());

      allow create: if signedIn() && request.resource.data.merchantId == request.auth.uid;

      allow update: if signedIn() && (
        isAdmin() || (isOwnerByMerchantId() && sellerUpdateDoesNotTouchAdminSupportFields())
      );

      allow delete: if false;
    }

    /* ---------- merchantMedia (seller image library) ---------- */
    match /merchantMedia/{docId} {
      allow get:  if signedIn() && (isOwnerByMerchantId() || isAdmin());
      allow list: if signedIn() && (isAdmin() || isOwnerByMerchantId());
      allow create, update, delete: if false; // server only
    }

    /* ---------- productUpdates (legacy seller edit queue) ---------- */
    // Nothing in the current panel reads or writes this collection; seller
    // edits now go through merchantProducts.pendingUpdates. Kept so any
    // historical documents stay protected.
    match /productUpdates/{docId} {
      allow get:  if signedIn() && (isOwnerByMerchantId() || isAdmin());
      allow list: if signedIn() && (isAdmin() || isOwnerByMerchantId());
      allow create: if signedIn() && request.resource.data.merchantId == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------- server-only collections ---------- */
    // skuClaims, shopifyProductOwners and adminSettings are also covered by
    // the default deny below.
    match /webhookEvents/{id} { allow read, write: if false; }
    match /debugWrites/{id}   { allow read, write: if false; }

    /* ---------- default deny ---------- */
    match /{document=**} { allow read, write: if false; }
  }
}
